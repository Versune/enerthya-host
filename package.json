{
  "name": "enerthya",
  "version": "0.12.5",
  "private": true,
  "description": "Self-hosted deployment platform: servers, projects, deployments, domains, backups.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/dev-env.mjs",
    "dev": "pnpm --filter @enerthya/web dev",
    "dev:worker": "pnpm --filter @enerthya/worker dev",
    "build": "pnpm --filter @enerthya/web build",
    "build:worker": "pnpm --filter @enerthya/worker build",
    "start": "pnpm --filter @enerthya/web start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "db:generate": "pnpm --filter @enerthya/db generate",
    "db:migrate": "pnpm --filter @enerthya/db migrate",
    "db:studio": "pnpm --filter @enerthya/db studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "5.9.3"
  }
}
