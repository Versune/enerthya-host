# Copy to .env for local development. Never commit .env.
# Values here match docker-compose.yml and packages/db/drizzle.config.ts.

DATABASE_URL=postgres://enerthya:enerthya@127.0.0.1:5432/enerthya
REDIS_URL=redis://127.0.0.1:6379

# Generate both with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 32 bytes, base64. Encrypts env vars, SSH keys, credentials and channel config.
ENCRYPTION_KEY=

PORT=3000
HOSTNAME=127.0.0.1
